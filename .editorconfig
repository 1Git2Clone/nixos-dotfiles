# shfmt reads .editorconfig, and ONLY .editorconfig — it has no config file of
# its own. A .shfmt.toml (as in the dotfiles repo) is silently ignored, which
# is why the hook kept demanding tabs while the file said indent = 2.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

# shfmt formats zsh too (conform.nvim runs it on save), and the dotfiles have
# no .sh extension to match on, so they are named here.
[{*.sh,*.bash,*.zsh,dot-bashrc,dot-zshrc,dot-profile}]
# Keep `case` arms indented inside the case block; shfmt's default flattens
# them against the left margin, which reads badly in install-test.sh.
switch_case_indent = true
# space_redirects deliberately off: it rewrites `2>/dev/null` into
# `2> /dev/null`, which is not how anyone writes shell.
space_redirects = false

[*.{rs,java}]
indent_size = 4

[Makefile]
indent_style = tab
