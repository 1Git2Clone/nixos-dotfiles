result
result-*
.direnv/

# Agent scratch state — logs and pids, not configuration.
.remember/

# VM rehearsal artifacts. The harness keeps these in ~/.cache/nixos-vm-test by
# default, but WORK= can point it here.
*.qcow2
*.iso
*.ppm
OVMF_VARS.fd
serial.log
monitor.sock

# The encrypted hash file IS committed — it is sops ciphertext and that is the
# whole point. These patterns catch the plaintext forms of it.
*.dec
*.plain
secrets/*.yaml.tmp

# The handbook's render, and the two files `mdbook-mermaid install docs` writes
# verbatim at a version flake.lock already pins.
docs/book/
docs/mermaid.min.js
docs/mermaid-init.js
