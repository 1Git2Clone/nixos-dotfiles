{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/minimax/minimax-m3.1-flash",
  "plugin": [
    "oh-my-opencode-slim",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@knikolov/opencode-plugin-simple-memory",
    "opencode-pty",
    "opencode-morph-fast-apply",
    "~/.config/opencode/ponytail.mjs",
    "@csuwl/opencode-memory-plugin",
    "@fpytloun/opencode-mnemory",
    "opencode-plugin-preload-skills"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "memory-automation": {
      "description": "Automatically saves important information to memory",
      "mode": "subagent",
      "tools": {
        "memory_write": true,
        "memory_read": true,
        "memory_search": true,
        "vector_memory_search": true
      },
      "permission": {
        "memory_write": "allow",
        "memory_read": "allow",
        "memory_search": "allow",
        "vector_memory_search": "allow"
      }
    },
    "memory-consolidate": {
      "description": "Consolidates daily logs into long-term memory",
      "mode": "subagent",
      "tools": {
        "memory_write": true,
        "memory_read": true,
        "memory_search": true,
        "vector_memory_search": true,
        "list_daily": true,
        "rebuild_index": true
      },
      "permission": {
        "memory_write": "allow",
        "memory_read": "allow",
        "memory_search": "allow",
        "vector_memory_search": "allow",
        "list_daily": "allow",
        "rebuild_index": "allow"
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": ["codebase-memory-mcp"]
    },
    "playwright": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:8931/mcp"
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8932/servers/sequential-thinking/mcp"
    },
    "openrouter-image": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:8932/servers/openrouter-image/mcp"
    }
  },
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.minimax.io/v1",
        "apiKey": "{env:MINIMAX_API_KEY}"
      },
      "models": {
        "minimax-m3": {
          "id": "MiniMax-M3",
          "name": "MiniMax M3",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "cost": {
            "input": 0.3,
            "output": 1.2
          },
          "modalities": {
            "input": ["text", "image"]
          }
        }
      }
    }
  },
  "instructions": [
    "~/.opencode/memory/SOUL.md",
    "~/.opencode/memory/AGENTS.md",
    "~/.opencode/memory/USER.md",
    "~/.opencode/memory/IDENTITY.md",
    "~/.opencode/memory/TOOLS.md",
    "~/.opencode/memory/MEMORY.md"
  ],
  "tools": {
    "memory_write": true,
    "memory_read": true,
    "memory_search": true,
    "vector_memory_search": true,
    "list_daily": true,
    "init_daily": true,
    "rebuild_index": true,
    "index_status": true
  }
}
