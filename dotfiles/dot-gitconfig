[user]
  name = Ivan
  email = ivan@hu-tao.dev
  signingkey = D7B6F6EB50C776B2A0ABFC2AE656E12B8EADC31C
[credential]
  helper = cache --timeout=3600
[ghq]
  root = ~/Projects
[init]
  defaultBranch = main
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[url "https://github.com/1Git2Clone/"]
  insteadOf = "gh/1g2c/"
[url "https://github.com/"]
  insteadOf = "gh/"
[url "https://gitlab.com/1Kill2Steal/"]
  insteadOf = "gl/1k2s/"
[url "https://gitlab.com/"]
  insteadOf = "gl/"
[url "https://codeberg.org/1Kill2Steal/"]
  insteadOf = "cb/1k2s/"
[url "https://codeberg.org/"]
  insteadOf = "cb/"
[alias]
  pushall = !git remote | xargs -L1 git push --all
[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
[credential "https://git.hu-tao.dev"]
  # Empty first: the cache above would answer with a stale token. The file is
  # the sops template git-credentials-hutao in modules/sops.nix: a PAT that
  # does not expire. GCM was here, and the first push each hour failed once.
  # Lookups only: after a push git asks the helper to save, and plain `store`
  # then fails to lock a file in root's /run/secrets/rendered.
  helper =
  helper = "!f() { test \"$1\" = get && git credential-store --file=/run/secrets/rendered/git-credentials-hutao get; }; f"
[commit]
  gpgSign = true
[pull]
  rebase = true
[diff]
  tool = nvimdiff
[difftool "nvimdiff"]
  path = nvim
[difftool]
  prompt = false
