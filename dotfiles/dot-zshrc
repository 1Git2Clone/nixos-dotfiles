#!/bin/zsh

###############################################################################
# The .profile config for both Bash and Zsh.
###############################################################################

# NOTE: Contains the $ZSH export
source $HOME/.profile

################################################################################
# Zsh only functions
################################################################################

# $ needs an escape in Zsh while in Bash it straight up doesn't work and stops
# the parsing.
\$() { "$@"; }

###############################################################################
# The default ZSH variables.
###############################################################################

# Unneeded due to starship eval.
# ZSH_THEME="robbyrussell"

plugins=(git zsh-autosuggestions zsh-vi-mode copyfile zsh-syntax-highlighting
  catimg colored-man-pages colorize vim-interaction)

source $ZSH/oh-my-zsh.sh

###############################################################################
# Zsh keybinds
###############################################################################
# bindkey '^f' autosuggest-accept

###############################################################################
# Startup programs in the terminal using eval.
###############################################################################

# zoxide + fzf
# https://github.com/ajeetdsouza/zoxide
eval "$(zoxide init --cmd cd zsh)"

# Starship
# https://github.com/starship/starship
eval "$(starship init zsh)"

alias ls='lsd --color=auto'

precmd() {
  $PROFILE_PROMPT_COMMANDS
}
export PATH="$HOME/.npm-global/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Added by codebase-memory-mcp install
export PATH="$HOME/.local/bin:$PATH"

. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

function zvm_after_init() {
  bindkey -M viins '^R' atuin-search-viins
  bindkey -M viins '^S' atuin-search-viins
}

###############################################################################
# Notify when a command ran long and its pane isn't on screen (shell-notify).
###############################################################################
SHELL_NOTIFY_MIN=30 # seconds
# Interactive by nature: they run long because you're using them.
SHELL_NOTIFY_SKIP=(nvim vim vi ssh mosh less more man htop btop top tmux watch
  claude opencode yazi lazygit)

zmodload zsh/datetime
autoload -Uz add-zsh-hook

_shell_notify_preexec() {
  _shell_notify_cmd=$1 _shell_notify_start=$EPOCHSECONDS _shell_notify_line=
  # Where its output starts, so shell-notify can read it back from the pane.
  [[ -n $TMUX_PANE ]] &&
    _shell_notify_line=$(tmux display -p -t "$TMUX_PANE" '#{e|+:#{history_size},#{cursor_y}}')
}

_shell_notify_precmd() {
  local st=$? words
  [[ -n $_shell_notify_start ]] || return
  local secs=$((EPOCHSECONDS - _shell_notify_start))
  _shell_notify_start=
  ((secs >= SHELL_NOTIFY_MIN)) || return
  words=(${(z)_shell_notify_cmd})
  [[ $words[1] == sudo ]] && shift words
  [[ " ${SHELL_NOTIFY_SKIP[*]} " == *" ${words[1]:t} "* ]] && return
  # In a subshell, so job control neither prints [1] nor waits on it.
  (shell-notify send "$st" "$secs" "$_shell_notify_line" "$_shell_notify_cmd" &>/dev/null &)
}

add-zsh-hook preexec _shell_notify_preexec
add-zsh-hook precmd _shell_notify_precmd
